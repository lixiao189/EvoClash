# HTTPS front for `make lan`. The matchmaker stays on plain HTTP on the host;
# browsers away from localhost only allow WebTransport from an HTTPS page.
# The match itself is UDP and does not pass through this proxy.
server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    location / {
        proxy_pass http://${MATCHMAKER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }
}
